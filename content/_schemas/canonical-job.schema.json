{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansobooks.com/schemas/canonical-job.schema.json",
  "title": "KansoBooks Canonical Jobs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobs"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "status": { "type": "string" },
    "owner": { "type": "string" },
    "lastReviewed": { "type": "string", "format": "date" },
    "nextReview": { "type": "string", "format": "date" },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "readerJob", "pillar", "duplicatePolicy"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "readerJob": { "type": "string", "minLength": 1 },
          "pillar": { "type": "string", "minLength": 1 },
          "duplicatePolicy": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
