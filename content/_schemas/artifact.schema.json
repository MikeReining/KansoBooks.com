{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansobooks.com/schemas/artifact.schema.json",
  "title": "KansoBooks Content Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "artifactType",
    "jurisdiction",
    "risk",
    "sourceNotes",
    "professionalBoundary",
    "owner",
    "lastReviewed",
    "nextReview",
    "content"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "artifactType": {
      "type": "string",
      "enum": ["checklist", "template", "sample-package", "decision-tree", "table", "worked-example"]
    },
    "jurisdiction": {
      "type": "string",
      "enum": ["general", "us-general", "canada-general", "state-specific", "province-specific", "not-applicable"]
    },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "sourceNotes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "professionalBoundary": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "lastReviewed": { "type": "string", "format": "date" },
    "nextReview": { "type": "string", "format": "date" },
    "content": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
